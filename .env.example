# Non-secret local configuration. JSON array of explicitly authorized roots.
# FACTORY_ALLOWED_ROOTS=["/absolute/path/to/authorized/project/root"]
# FACTORY_DATA_DIR=/absolute/path/to/local/data
# Model calls require explicit content authorization and budget holds. Never put secrets in NEXT_PUBLIC_*.
# A2 uses the protected workbench configuration form to write FACTORY_MODEL_KEY
# and FACTORY_MODEL_BASE_URL to ignored .env (0600). Saving does not call the model.
# FACTORY_MODEL_NAME=qwen-plus-2025-12-01
